{
  "name": "@blinkered/attestation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm format:check && pnpm coverage",
    "attest": "tsc --build && node dist/src/main.js",
    "roll": "node scripts/languages.mjs --remote",
    "chart": "node scripts/languages.mjs && python3 -m http.server 8765",
    "roll:local": "node scripts/languages.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.8",
    "hyparquet-writer": "^0.16.9",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@blinkered/engine": "file:../blinkered/packages/engine",
    "hyparquet": "^1.31.1",
    "hyparquet-compressors": "^1.1.2"
  }
}
